# Copy this file to .env.local and provide values appropriate to the deployment.
PORT=5173
APP_HOST=127.0.0.1
# Local development uses SQLite. Production uses a secret PostgreSQL URL from Neon.
DATABASE_PATH=database.sqlite
DATABASE_URL=
TRUST_PROXY=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
