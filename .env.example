# Cloudflare Workers + Hono application.
#
# In production, all secrets and bindings are configured in the Cloudflare
# dashboard / wrangler.toml. These variables are used only by the Node.js
# local-development entry point (npm run dev:node).
#
# Copy this file to .env.local for local development overrides.

# Local development: leave DATABASE_URL empty to use SQLite, or set a
# PostgreSQL connection string to test against a real database.
DATABASE_PATH=database.sqlite
DATABASE_URL=

# Gemini AI (server-only). Never use VITE_-prefixed names.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Required in production: the HTTPS origin of the deployed app.
# Used for the same-origin CSRF check.
APP_ORIGIN=http://127.0.0.1:5173

# Set to "production" for production behavior. Wrangler sets this automatically.
NODE_ENV=development

# Local Node.js port (only used by `npm run dev:node`).
PORT=5173
