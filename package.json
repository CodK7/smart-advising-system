{
  "name": "utas-smart-academic-advising",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "cross-env NODE_ENV=development npm run db:ensure",
    "dev": "wrangler dev",
    "dev:node": "cross-env NODE_ENV=development PORT=5173 tsx server.ts",
    "dev:frontend": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node --import tsx server.ts",
    "db:ensure": "node --import tsx database/ensure.ts",
    "db:reset": "node --import tsx database/seed.ts",
    "db:reset:postgres": "node --import tsx database/postgres-seed.ts",
    "db:verify": "node --import tsx database/verify.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:api": "node --import tsx tests/api.test.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:dev": "node tests/dev-command-smoke.mjs",
    "test:production": "node tests/production-smoke.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:db && npm run test:unit && npm run test:api",
    "verify:release": "npm run db:ensure && npm run db:verify && npm run test:db && npm run typecheck && npm run lint && npm run test:unit && npm run test:api && npm run test:browser && npm run test:dev && npm run build && npm run test:production",
    "cf:dev": "wrangler dev",
    "cf:build": "npm run build",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "dotenv": "^17.2.3",
    "hono": "^4.7.5",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint/js": "^9.32.0",
    "@hono/node-server": "^1.14.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.54.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.16.0"
  },
  "overrides": {
    "pm2": {
      "js-yaml": "4.3.1"
    }
  }
}
